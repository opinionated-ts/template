{
  "name": "@opinionated-ts/template",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opinionated-ts/template.git"
  },
  "type": "module",
  "scripts": {
    "cspell": "cspell lint .",
    "fmt": "oxfmt --check .",
    "fmt:fix": "oxfmt .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "bun fmt && bun lint && bun cspell",
    "fix": "bun fmt:fix && bun lint:fix",
    "hooks:install": "lefthook install",
    "skills:install": "bun skills experimental_install",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "audit": "bun audit fix --ignore GHSA-vfj7-8cjw-p6xm"
  },
  "devDependencies": {
    "@opinionated-ts/config": "^1.9.1",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-istanbul": "5.0.1",
    "skills": "^1.7.0",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": "^1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
